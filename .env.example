# Artifact Relay configuration template.
# Prefer ./scripts/bootstrap.sh, which creates .env with generated secrets and mode 0600.
# Every value below is an inert placeholder; never commit a filled .env.

ARTIFACT_API_TOKEN=replace-me-with-at-least-16-random-characters
VIEW_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$REPLACE$REPLACE'
SESSION_SECRET_KEY=replace-me-with-at-least-32-random-characters

# Safe localhost defaults. The VPS override enforces HTTPS values.
BASE_URL=http://localhost:8000
DATA_DIR=/data
COOKIE_SECURE=false
SHARE_LINKS_ENABLED=false
LOG_LEVEL=INFO
FORWARDED_ALLOW_IPS=127.0.0.1

DEFAULT_TTL_DAYS=30
MAX_TTL_DAYS=3650
SESSION_TTL_DAYS=30
JANITOR_INTERVAL_SECONDS=3600
EMBED_TOKEN_TTL_SECONDS=3600

MAX_TITLE_CHARS=200
MAX_SUMMARY_CHARS=600
MAX_CONTENT_BYTES=5242880
MAX_ASSETS=20
MAX_ASSET_BYTES=20971520

LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900
LOGIN_MAX_CONCURRENT_VERIFICATIONS=4
